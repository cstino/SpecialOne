# Cloudflare Pages — equivalente di "headers" in vercel.json
#
# Tenuti allineati a mano: se si toccano qui vanno toccati anche la',
# altrimenti i due host servono lo stesso sito con regole diverse.

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Gli asset col nome versionato da Vite (index-ABC123.js) non cambiano mai
# contenuto a parita' di nome: si possono tenere in cache per un anno.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Il service worker no: se il browser lo tenesse in cache, un aggiornamento
# del sito non arriverebbe mai a chi ha gia' la PWA installata.
/sw.js
  Cache-Control: no-cache
